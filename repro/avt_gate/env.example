# Copy to env.local (not committed) and edit. Values below are the current lab (BU SCC) locations of the shared experiment data.
export T2AV_WORKSPACE=/projectnb/ivc-ml/youngsun/T2AV_Temporal_Constraint   # experiment workspace: eval_results/, new_prompts/, captions, runs/
export T2AV_DATA=/projectnb/ivc-ml/youngsun/T2AV_data                       # videos, GT, tool outputs (Whisper/FLAM/Synchformer), HD-EPIC clips
export T2AV_HF_CACHE=/projectnb/ivc-ml/youngsun/.hf_cache                   # only for tool re-extraction (OpenFLAM checkpoint: $T2AV_HF_CACHE/openflam)
export T2AV_EXT_TMP=/projectnb/ivc-ml/youngsun/tmp                          # only for Synchformer re-extraction (external checkouts)
export T2AV_OUT_DIR=$HOME/t2av_repro_out                                    # all new outputs go here (one sub-directory per --tag)
# Gemini key: only needed when Stage-2 / Stage-1 calls are re-run. Set it in your shell, never in a file in the repo:
#   export GEMINI_API_KEY=...
